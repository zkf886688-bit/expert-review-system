# 复制为 .env 后供 docker compose 使用：cp .env.example .env
# 生产环境务必修改 JWT_SECRET 与 MYSQL_ROOT_PASSWORD

# --- 数据库 ---
MYSQL_ROOT_PASSWORD=change-me-strong-password

# --- 安全 ---
# 至少 32 字符的随机字符串；部署前 scripts/check-deploy 会校验
JWT_SECRET=change-me-use-long-random-secret-at-least-32-chars

# --- CORS（生产 SPRING_PROFILES_ACTIVE=prod 时生效）---
# 多个来源用英文逗号分隔，需包含实际前端访问域名
CORS_ALLOWED_ORIGIN_PATTERNS=https://your-frontend.example.com

# --- 邮件（可选）---
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com

# --- 短信（可选：mock | aliyun | tencent）---
SMS_ENABLED=false
SMS_PROVIDER=mock

# 阿里云短信
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 腾讯云短信
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# --- 裸机部署（非 Docker，SPRING_PROFILES_ACTIVE=prod）---
# DB_URL=jdbc:mysql://localhost:3306/expert_review?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# DB_USER=root
# DB_PASSWORD=your-db-password
# UPLOAD_DIR=./uploads
